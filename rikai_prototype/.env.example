# Chọn provider LLM đang dùng: openai | groq | openrouter
API_PROVIDER=openai

# Model tương ứng với provider đã chọn
MODEL=gpt-4o-mini

# Điền API key tương ứng với provider đã chọn ở trên (chỉ cần điền 1 cái)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Qdrant - CHƯA sử dụng ở giai đoạn này (stub), để trống cũng chạy được
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rikai_standards
